# Auto-detect text files; normalize to LF in the repo
* text=auto eol=lf

# Rust / config / docs / shell
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Verilog HDL
*.v text eol=lf
*.vh text eol=lf
*.sv text eol=lf
*.svh text eol=lf
*.vl text eol=lf

# Binary / build artifacts (never treat as text)
*.exe binary
*.dll binary
*.lib binary
*.a binary
*.o binary
*.obj binary
*.pdb binary
*.rlib binary
*.rmeta binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary

# Vendored third-party trees
vendor/** linguist-vendored
