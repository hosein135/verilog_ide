<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Verilog IDE"
           Language="1033"
           Version="0.1.0.0"
           Manufacturer="Verilog IDE"
           UpgradeCode="7C2E9A14-5B60-4D33-A8F1-2E6C4B90D1A8">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64"
             Description="Desktop IDE for Verilog HDL and testbenches"
             Comments="Simulates Verilog with xezim and opens the VCD waveform." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Verilog IDE is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\verilog-ide.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Condition Message="Verilog IDE requires 64-bit Windows.">
      <![CDATA[VersionNT64]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="Verilog IDE">
          <Component Id="AppExe" Guid="C3A91E44-2B10-4E7A-8F55-0A6D2E9B71C4" Win64="yes">
            <File Id="VerilogIdeExe"
                  Name="verilog-ide.exe"
                  Source="target\release\verilog-ide.exe" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\VerilogIDE"
                           Name="exe"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>

          <Directory Id="SamplesDir" Name="samples">
            <Directory Id="HalfAdderDir" Name="half_adder">
              <Component Id="HalfAdderFiles" Guid="E18B6D20-4C55-4F0A-9A31-7B2C8D0E4F61" Win64="yes">
                <File Id="HalfAdderV" Source="samples\half_adder\half_adder.v" />
                <File Id="HalfAdderTb" Source="samples\half_adder\half_adder_tb.v" />
                <RemoveFolder Id="RemoveHalfAdderDir" Directory="HalfAdderDir" On="uninstall" />
                <RemoveFolder Id="RemoveSamplesDir" Directory="SamplesDir" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\VerilogIDE"
                               Name="sample"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Verilog IDE" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="A4D8F012-91C3-4B77-8E20-6F5A1C3D9B48" Win64="yes">
        <Shortcut Id="StartMenuLink"
                  Name="Verilog IDE"
                  Description="Edit Verilog, run a testbench, and view the waveform"
                  Target="[INSTALLFOLDER]verilog-ide.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\VerilogIDE"
                       Name="startmenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="B91E4C70-2A55-4F18-9D33-8C6E1A0B47D2" Win64="yes">
        <Shortcut Id="DesktopLink"
                  Name="Verilog IDE"
                  Description="Edit Verilog, run a testbench, and view the waveform"
                  Target="[INSTALLFOLDER]verilog-ide.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\VerilogIDE"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Verilog IDE" Level="1">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="HalfAdderFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
  </Product>
</Wix>
